{
	"name": "scriptwriter",
	"version": "1.1.1",
	"description": "✍️  An authoring tool for playwrights.",
	"keywords": [
		"playwright",
		"repl",
		"e2e",
		"testing",
		"Chromium",
		"Puppeteer"
	],
	"homepage": "https://github.com/AutoSponge/scriptwriter#readme",
	"bugs": {
		"url": "https://github.com/AutoSponge/scriptwriter/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AutoSponge/scriptwriter.git"
	},
	"license": "MIT",
	"author": "Paul Grenier <pgrenier@gmail.com>",
	"type": "module",
	"main": "./index.js",
	"bin": {
		"scriptwriter": "bin/cli.js"
	},
	"directories": {
		"doc": "docs",
		"lib": "lib"
	},
	"scripts": {
		"docs": "documentation build --shallow lib/** -f html -o docs",
		"lint:docs": "documentation lint --shallow ./lib/**",
		"lint:code": "prettier-eslint --write --single-quote --use-tabs --ignore \"coverage/**\" --ignore \"node_modules/**\" \"**/*.{js,json,md}\"",
		"lint": "run-p lint:*",
		"start": "node ./bin/cli.js",
		"test:dev": "cross-env NODE_ENV=test ava",
		"test:ci": "cross-env NODE_ENV=test c8 --reporter=text ava --tap",
		"cover:html": "c8 report --reporter=html",
		"test": "run-s lint test:ci",
		"version": "run-s lint docs",
		"release": "release-it",
		"prepare": "husky"
	},
	"dependencies": {
		"@prettier/sync": "^0.6.1",
		"ansi-escapes": "^7.3.0",
		"dlv": "^1.1.3",
		"import-global": "^1.1.1",
		"kleur": "^4.1.5",
		"meow": "^14.1.0",
		"normalize-url": "^9.0.0",
		"pretty-error": "^4.0.0",
		"terminal-link": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"ava": "^8.0.0",
		"c8": "^11.0.0",
		"cross-env": "^10.1.0",
		"documentation": "^14.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.3",
		"prettier-eslint": "^16.4.2",
		"prettier-eslint-cli": "^8.0.1",
		"release-it": "^17.6.0",
		"tempfile": "^6.0.1"
	},
	"peerDependencies": {
		"playwright": "^1.60.0"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged",
			"commit-msg": "commitlint -e $GIT_PARAMS"
		}
	},
	"lint-staged": {
		"**/*.{js}": "npm run lint:docs",
		"**/*.{js,json,md}": "npm run lint:code"
	}
}
